# Configurações do Firebase
# Obtenha estes valores no Console do Firebase -> Configurações do Projeto -> Seus Aplicativos (Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Segurança de Autenticação
# VITE_ALLOWED_EMAIL: (Opcional) restringe o login geral no aplicativo a este e-mail
VITE_ALLOWED_EMAIL=

# VITE_OWNER_EMAIL: E-mail do proprietário com acesso exclusivo aos Insights Financeiros e Reserva de Emergência
VITE_OWNER_EMAIL=renatofranca2881@gmail.com

# Segredo do Webhook de Notificações Bancárias
WEBHOOK_SECRET=sua_chave_secreta_aqui
